[Unit]
Description=CloudStack guest password + SSH key management (configdrive + VR)
After=network-online.target cloud-config.service
Wants=network-online.target
# idle: give DHCP/network a moment so eth0 has an address & route
[Service]
Type=oneshot
ExecStart=/usr/local/bin/cloudstack-set-guest-sshkey-password
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
