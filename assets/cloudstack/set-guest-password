#!/bin/bash
# =====================================================================
# CloudStack guest password management (KVM)
# Fetches the VM password from the virtual router password server and
# applies it to root AND the distro default cloud user (CloudStack
# deployments commonly log in as the template's default user, not
# root). Idempotent: after first successful application it leaves a
# marker so later boots keep "saved_password" semantics.
# Registered as a systemd oneshot: cloudstack-password.service
# =====================================================================
TAG=cs-set-password
MARKER=/var/lib/cloudstack/.password_saved

ROUTER_IP=$(ip route show default 2>/dev/null | awk '{print $3; exit}')
[ -n "$ROUTER_IP" ] || { logger -t "$TAG" "no default route, skipping"; exit 0; }

PASSWORD=$(curl -sf --max-time 15 "http://${ROUTER_IP}:8080/latest/password" 2>/dev/null) || exit 0
[ -n "$PASSWORD" ] || exit 0

# Router says the password was already delivered before
[ "$PASSWORD" = "saved_password" ] && exit 0
[ -e "$MARKER" ] && exit 0

# resolve the distro default cloud user: cloud-init's default_user,
# falling back to the first regular human account (uid >= 1000)
DEFAULT_USER=$(awk '
    /default_user:/ {inblock=1}
    inblock && $1=="name:" {sub(":","",$1); print $2; exit}
' /etc/cloud/cloud.cfg 2>/dev/null)
if [ -z "$DEFAULT_USER" ]; then
    DEFAULT_USER=$(awk -F: '$3 >= 1000 && $3 < 65534 \
        && $7 !~ /(nologin|false)$/ {print $1; exit}' /etc/passwd)
fi

APPLIED=""
for U in root ${DEFAULT_USER}; do
    [ "$(id -u "$U" 2>/dev/null)" ] || continue
    echo "${U}:${PASSWORD}" | chpasswd && APPLIED="$APPLIED $U"
done
[ -n "$APPLIED" ] || { logger -t "$TAG" "no target user found"; exit 0; }

# Make sure password SSH login works when template registered with
# "Password Enabled" in CloudStack
sed -i -E 's/^#?[[:space:]]*PasswordAuthentication[[:space:]].*/PasswordAuthentication yes/' /etc/ssh/sshd_config
systemctl reload sshd 2>/dev/null || systemctl restart sshd 2>/dev/null \
    || systemctl restart ssh 2>/dev/null || true

mkdir -p "$(dirname "$MARKER")"
touch "$MARKER"
logger -t "$TAG" "root password applied from virtual router"
exit 0
